{
  "name": "nakama-research-dashboard",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Research dashboard plugin for a self-hosted Nakama instance: one dashboard page plus five agent tools over shared coordination state (topics, development axes, evidence).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:host": "bun harness/typecheck-host.mjs",
    "build": "bun build ./src/actions.ts --outdir actions --target bun && bun build ./src/ui.tsx --outfile ui/app.js --target browser",
    "build:watch": "bun build ./src/ui.tsx --outfile ui/app.js --target browser --watch --no-clear-screen",
    "test": "bun test src",
    "check": "bun run typecheck && bun run build && bun test src",
    "librarian:evaluate": "bun src/librarian/evaluate.ts",
    "librarian:semantic-eval": "bun harness/librarian-generation/run.mjs",
    "librarian:semantic-eval:export": "bun harness/librarian-generation/export-pack.mjs",
    "librarian:semantic-eval:test": "bun harness/librarian-generation/run-tests.mjs",
    "harness:read": "bash harness/read-pass.sh",
    "harness:fixture": "bash harness/read-pass.sh --dataset fixture",
    "harness:seed": "bun harness/replay-corpus.mjs",
    "harness:install": "bun harness/install-plugin.mjs",
    "harness:reinstall": "bun harness/reinstall-plugin.mjs",
    "harness:update": "bun harness/update-plugin.mjs",
    "harness:test": "bun harness/test-004.mjs",
    "harness:records": "bun harness/test-redact.mjs",
    "harness:focus": "bash harness/focus-pass.sh",
    "harness:identity": "bun harness/test-dataset-identity.mjs",
    "harness:boundary": "bun harness/test-people-boundary.mjs",
    "harness:wp5": "bun harness/wp5/run.mjs",
    "harness:wp5:test": "bun test harness/wp5/wp5-checks.test.mjs",
    "harness:fulltext": "bun harness/full-text-clamp/check.mjs --serve",
    "harness:fulltext:preflight": "bun harness/full-text-clamp/check.mjs --preflight",
    "harness:fulltext:test": "bun test harness/full-text-clamp/integrity.test.mjs",
    "harness:write": "bash harness/read-pass.sh --write",
    "preview": "bun harness/preview/run.mjs",
    "preview:fixture": "bun harness/preview/run.mjs --dataset fixture",
    "preview:capture": "bun harness/preview/capture.mjs",
    "preview:fidelity": "bun harness/preview/fidelity.mjs"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "18",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
