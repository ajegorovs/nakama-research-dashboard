    },
    {
      "key": "record_activity",
      "access": "member",
      "effect": "write",
      "entry": "actions/actions.js",
      "exposeAsTool": true,
      "description": "Record one objective event that already happened against a topic (and optionally an axis): a merged pull request, a finished run, a commit, a document update. Put the identifier in sourceRef (PR #72, commit hash, run id, path) and pick the matching sourceType. Facts only — for a milestone claim a human stated, use reconcile_topic's summary instead. A repository named here is registered automatically. Naming a problemId records the event as evidence for that problem, which is what lets a problem show why it was raised.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "topicId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "topicName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "axisId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "axisTitle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "sourceType": {
            "type": "string",
            "enum": [
              "manual",
              "github_pr",
              "github_commit",
              "github_issue",
              "repo_document",
              "group_chat",
              "experiment",
              "agent_review"
            ]
          },
          "sourceRef": {
            "type": "string",
            "maxLength": 200
          },
          "sourceUrl": {
            "type": "string",
            "maxLength": 500
          },
          "occurredAt": {
            "type": "string",
            "maxLength": 40
          },
          "repositoryFullName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": ["summary"]
      }
    },
    {
      "key": "list_topics",
      "access": "member",
      "effect": "read",
      "entry": "actions/actions.js",
      "exposeAsTool": false,
      "description": "List topics for the dashboard page, most recently updated first, optionally filtered by status. Not an agent tool: the agent uses get_overview / search_dashboard, which carry the context this list leaves out.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": ["active", "paused", "completed", "archived"]
          }
        },
        "required": []
      }
    },
    {
      "key": "get_progress",
      "access": "member",
      "effect": "read",
      "entry": "actions/actions.js",
      "exposeAsTool": false,
      "description": "The Progress view in one call: the axis index (each axis in attention order with its topic, state, stale flag, plan, problem counts, latest activity and append-only state history) and the problem index (open and resolved problems with their parent axis and topic, affected repositories, evidence, plan step and resolution/reopen history). Both come from one window — `activitySinceDays` — so the two halves cannot disagree. Powers the page's Progress view; not exposed as an agent tool.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "activitySinceDays": {
            "type": "integer",
            "minimum": 0,
            "maximum": 365
          },
          "includeArchived": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": []
      }
    },
    {
      "key": "list_activity",
      "access": "member",
      "effect": "read",
      "entry": "actions/actions.js",
      "exposeAsTool": false,
      "description": "List recorded activity, newest first, optionally filtered to one topic or axis and to a time window. Powers the page's activity panel.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "topicId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "axisId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "sinceDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365
          }
        },
        "required": []
      }
    },
    {
      "key": "add_annotation",
      "access": "member",
      "effect": "write",
      "entry": "actions/actions.js",
      "exposeAsTool": false,
      "description": "Attach a note to a topic or an axis: conversation-derived context that is not an event. The author is taken from the session, never from input. Not an agent tool: the librarian supplies annotations through reconcile_topic, where they can back a claim in the same transaction. kind defaults to note, which is context and may sit on a topic and an axis at once; interpretation and steering are claims about the record and must name exactly one target (axisId, problemId or topicId). confidence is optional and never assumed: omitting it records no claim rather than a confirmed one.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "topicId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "axisId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": ["text"]
      }
    },
    {
      "key": "ingest_github_activity",
      "access": "member",
      "effect": "write",
      "entry": "actions/actions.js",
      "exposeAsTool": false,
      "description": "Collector-only ingest of one externally observed GitHub fact. Not an agent tool and not reachable by a person: the host restricts this action to a trusted collector principal. The server derives the canonical event identity from the structured envelope (provider host + immutable repository id + object identity + event kind) and recomputes the payload digest; enrollment decides the Axis and Topic, and an optional Problem is honoured only through an approved object mapping. The recorded actor is `system`, and the upstream GitHub author is kept as separate provenance without creating a Person. Replay of the same identity and digest inserts nothing; a different digest under the same identity is a structured conflict.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "envelope": {
            "type": "object"
          }
        },
        "required": ["envelope"]
      }
    },
    {
      "key": "read_ingest_receipt",
      "access": "member",
      "effect": "read",
      "entry": "actions/actions.js",
      "exposeAsTool": false,
      "description": "Collector-only exact-key readback: look up the stored receipt for one canonical external event so a worker that lost a response can confirm whether its write landed before retrying. Reachable only by a trusted collector principal.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "providerHost": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "repositoryId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "eventKind": {
            "type": "string",
            "enum": ["pr.merged", "commit.observed"]
          },
          "objectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": ["providerHost", "repositoryId", "eventKind", "objectId"]
      }
    },
    {
      "key": "manage_external_enrollment",
      "access": "admin",
      "effect": "write",
      "entry": "actions/actions.js",
      "exposeAsTool": false,
      "description": "Admin-only enrollment management for external evidence. `enroll` binds an immutable repository identity to one existing Axis (the Topic is checked, not trusted); `map` approves one exact object-to-Problem mapping on the enrolled axis. The caller cannot name an arbitrary target: the axis must already exist, and a mapped Problem must belong to that axis. This is the only path that creates mapping authority; no test or worker may assert it inline.",
